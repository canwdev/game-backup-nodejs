{
  "name": "game-backup-cli",
  "type": "module",
  "version": "1.3.0",
  "license": "MIT",
  "repository": "https://github.com/canwdev/game-backup-cli.git",
  "bin": {
    "game-backup-cli": "./dist/game-backup-cli.cjs"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "dist"
  ],
  "scripts": {
    "dev": "bun --watch run src/main.ts",
    "build": "bun build --target=node --format=cjs --minify src/main.ts --outfile ./dist/game-backup-cli.cjs --banner '#!/usr/bin/env node\n'",
    "build:exe": "bun build --compile --minify --sourcemap --bytecode src/main.ts --outfile ./dist/game-backup-cli",
    "build:auto": "bun run ./docs/build.ts",
    "lint": "eslint src/**/*.{ts,tsx,vue} frontend/**/*.{ts,tsx,vue} --fix",
    "lint:backend": "eslint src/**/*.{ts,tsx,vue} --fix",
    "lint:frontend": "eslint frontend/**/*.{ts,tsx,vue} --fix"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8",
    "@types/node": "^24.12.2",
    "@types/which": "^3.0.4",
    "enquirer": "^2.4.1",
    "eslint": "^9.39.4",
    "eslint-plugin-format": "^1.5.0",
    "which": "^5.0.0"
  }
}